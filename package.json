{
  "name": "personal-website",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint-prettier": "prettier --check .",
    "lint-eslint": "eslint .",
    "lint": "prettier --check . && eslint .",
    "format-prettier": "prettier --write .",
    "format-eslint": "eslint . --fix",
    "format": "prettier --write . && eslint . --fix"
  },
  "devDependencies": {
    "@bradenmacdonald/s3-lite-client": "1.0.1",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@shikijs/core": "4.6.0",
    "@shikijs/engine-oniguruma": "4.6.0",
    "@shikijs/langs": "4.6.0",
    "@shikijs/rehype": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/adapter-vercel": "7.0.2",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-svelte": "3.24.0",
    "globals": "17.14.0",
    "gray-matter": "4.0.3",
    "mdsvex": "0.12.8",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.6.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "sveltekit-i18n": "3.4.1",
    "tailwindcss": "4.3.4",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vite": "8.3.6"
  },
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
