#!/usr/bin/env bash
set -e

function gopass() {
    mise exec gopass -- gopass "$@"
}

PERSONAL_WEBSITE_MINIO_ENDPOINT=$(gopass show s3/endpoint)
export PERSONAL_WEBSITE_MINIO_ENDPOINT
PERSONAL_WEBSITE_MINIO_PORT=$(gopass show s3/port)
export PERSONAL_WEBSITE_MINIO_PORT
PERSONAL_WEBSITE_MINIO_USE_SSL=$(gopass show s3/use_ssl)
export PERSONAL_WEBSITE_MINIO_USE_SSL
PERSONAL_WEBSITE_MINIO_ACCESS_KEY=$(gopass show s3/access_key)
export PERSONAL_WEBSITE_MINIO_ACCESS_KEY
PERSONAL_WEBSITE_MINIO_SECRET_KEY=$(gopass show s3/secret_key)
export PERSONAL_WEBSITE_MINIO_SECRET_KEY
PERSONAL_WEBSITE_MINIO_REGION=$(gopass show s3/region)
export PERSONAL_WEBSITE_MINIO_REGION
PERSONAL_WEBSITE_MINIO_BUCKET_NAME=$(gopass show s3/bucket_name)
export PERSONAL_WEBSITE_MINIO_BUCKET_NAME
